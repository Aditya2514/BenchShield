{
  "name": "benchshield-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint . && npm run lint:contracts",
    "lint:contracts": "redocly lint docs/contracts/openapi.yaml",
    "test": "npm run test --workspaces",
    "generate:client": "npm run generate --workspace=packages/api-client",
    "check:generated": "npm run generate:client && git diff --exit-code packages/api-client/src/schema.d.ts",
    "check:no-msw": "node scripts/check-no-msw.js"
  },
  "devDependencies": {
    "@redocly/cli": "2.72.1",
    "@types/node": "^22.13.1",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "6.4.5"
  },
  "overrides": {
    "vite": "6.4.5"
  }
}
